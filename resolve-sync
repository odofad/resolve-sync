#!/usr/bin/env bash
# resolve-sync — simple rsync tool for DaVinci Resolve project mags

set -euo pipefail

CONFIG="${HOME}/.resolve-sync.conf"
# Prefer packaged location, fall back to next to the script (dev)
if [[ -d /usr/share/resolve-sync/bank ]]; then
  BANK_DIR=/usr/share/resolve-sync/bank
else
  BANK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bank"
fi

# Load config if present
if [[ -f "$CONFIG" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG"
fi

require_config() {
  if [[ ! -f "$CONFIG" || -z "${SOURCE_ROOT:-}" || -z "${REMOTE_HOST:-}" || -z "${REMOTE_ROOT:-}" ]]; then
    echo "No configuration found." >&2
    echo "Run: resolve-sync setup" >&2
    exit 1
  fi
}

usage() {
  cat <<EOF
resolve-sync — sync DaVinci Resolve project mags

USAGE
  resolve-sync <command> [args]

COMMANDS
  setup
      Interactive client setup. Writes ~/.resolve-sync.conf and optionally
      installs an SSH key on the server.

  setup-server
      Prepare the restricted media user and group on the server
      (run as root or with sudo). Does not own the media folders.

  new <ProjectName>
      Create a new project from the bank template.

  push [Project]
      With no argument, list local valid projects.
      With a name, push Bins proxies + Assists to the server.

  pull [Project] [--originals]
      With no argument, list valid projects on the server.
      With a name, pull proxies (default) or full Bins (--originals)
      plus Assists.

  delete <Project>
      Delete a project from the client only. Prompts to sync back first.

  test
      Self-test: config, paths, bank template, SSH.

  help, --help, -h
      Show this manual.

CONFIG
  ~/.resolve-sync.conf (created by setup)

    SOURCE_ROOT=/path/to/local/MasterFolder
    REMOTE_ROOT=/path/to/server/media
    REMOTE_HOST=resolvesync@server
    REMOTE_HOST_BACKUP=resolvesync@vpn-server   # optional
    SSH_OPTS="-o BatchMode=yes"

NOTES
  - Server holds the raws. Clients receive proxies by default.
  - A valid project has both Bins/ and Assists/ at the top level.
  - Timeline backups and advanced options are still TODO.

EOF
}

# SSH options as array for safe expansion
SSH_OPTS_ARRAY=()
if [[ -n "${SSH_OPTS:-}" ]]; then
  # shellcheck disable=SC2206
  SSH_OPTS_ARRAY=($SSH_OPTS)
fi

# A valid project has Bins/ and Assists/ at the top level
is_valid_project() {
  local path="$1"
  [[ -d "$path/Bins" && -d "$path/Assists" ]]
}

# Try primary host, fall back to backup if set and primary fails
get_working_host() {
  local host="${REMOTE_HOST:-}"
  if [[ -n "$host" ]] && ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" true 2>/dev/null; then
    echo "$host"
    return
  fi
  if [[ -n "${REMOTE_HOST_BACKUP:-}" ]] && ssh -o BatchMode=yes -o ConnectTimeout=5 "${REMOTE_HOST_BACKUP}" true 2>/dev/null; then
    echo "${REMOTE_HOST_BACKUP}"
    return
  fi
  echo "${REMOTE_HOST:-}"
}

cmd_test() {
  echo "=== resolve-sync self-test ==="
  local ok=0
  local fail=0

  # Config
  if [[ -f "$CONFIG" ]]; then
    echo "[OK] Config file exists: $CONFIG"
    ((ok++))
  else
    echo "[FAIL] Config file missing. Run: resolve-sync setup"
    ((fail++))
  fi

  if [[ -n "${SOURCE_ROOT:-}" && -d "$SOURCE_ROOT" ]]; then
    echo "[OK] SOURCE_ROOT exists: $SOURCE_ROOT"
    ((ok++))
  else
    echo "[FAIL] SOURCE_ROOT missing or not a directory"
    ((fail++))
  fi

  if [[ -n "${REMOTE_HOST:-}" ]]; then
    echo "[OK] REMOTE_HOST set: $REMOTE_HOST"
    ((ok++))
  else
    echo "[FAIL] REMOTE_HOST not set"
    ((fail++))
  fi

  # Bank template
  if [[ -d "$BANK_DIR/Assists" && -d "$BANK_DIR/Bins" && -d "$BANK_DIR/Timeline" ]]; then
    echo "[OK] Bank template present"
    ((ok++))
  else
    echo "[FAIL] Bank template incomplete at $BANK_DIR"
    ((fail++))
  fi

  # SSH
  local host
  host=$(get_working_host)
  if [[ -n "$host" ]] && ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" true 2>/dev/null; then
    echo "[OK] SSH to $host works"
    ((ok++))
  else
    echo "[FAIL] SSH to ${REMOTE_HOST:-?} failed (backup: ${REMOTE_HOST_BACKUP:-none})"
    ((fail++))
  fi

  echo
  echo "Results: $ok passed, $fail failed"
  if [[ $fail -eq 0 ]]; then
    echo "All basic checks passed."
    return 0
  else
    echo "Some checks failed."
    return 1
  fi
}

cmd_setup() {
  echo "=== resolve-sync client setup ==="
  read -rp "Remote host (user@host) [resolvesync@]: " remote_host
  remote_host=${remote_host:-resolvesync@}
  # If user only typed a hostname, prepend the default user
  if [[ "$remote_host" != *@* ]]; then
    remote_host="resolvesync@${remote_host}"
  fi
  read -rp "Backup host (optional, VPN): " remote_host_backup
  read -rp "Source root (local MasterFolder): " source_root
  read -rp "Remote root (server media folder): " remote_root

  mkdir -p "$(dirname "$CONFIG")"
  cat > "$CONFIG" <<EOF
SOURCE_ROOT=${source_root}
REMOTE_ROOT=${remote_root}
REMOTE_HOST=${remote_host}
REMOTE_HOST_BACKUP=${remote_host_backup}
SSH_OPTS="-o BatchMode=yes"
EOF
  echo "Config written to $CONFIG"

  key="${HOME}/.ssh/id_ed25519"
  if [[ ! -f "$key" ]]; then
    ssh-keygen -t ed25519 -f "$key" -N ""
  fi
  echo "Public key:"
  cat "${key}.pub"
  echo
  read -rp "Copy this key to the server now? [y/N] " yn
  if [[ "$yn" =~ ^[Yy] ]]; then
    if ! ssh-copy-id -i "${key}.pub" "$remote_host"; then
      echo
      echo "ssh-copy-id failed."
      echo "If you see 'This account is currently not available', the server user"
      echo "still has a nologin shell. On the server run:"
      echo "  sudo usermod -s /bin/bash resolvesync"
      echo "Then re-run this setup."
      exit 1
    fi
  fi
  echo "Client setup done."
}

cmd_setup_server() {
  echo "=== resolve-sync server setup (run as root or with sudo) ==="
  read -rp "Restricted username [resolvesync]: " ruser
  ruser=${ruser:-resolvesync}
  read -rp "Group name [media]: " group
  group=${group:-media}
  read -rp "Existing system users to add to group (space-separated): " users
  read -rp "Media root path: " media_root

  if ! getent group "$group" >/dev/null; then
    groupadd "$group"
    echo "Created group $group"
  fi

  if ! id "$ruser" >/dev/null 2>&1; then
    useradd -m -G "$group" -s /bin/bash "$ruser"
    echo "Created user $ruser (shell /bin/bash)"
  else
    usermod -aG "$group" "$ruser"
    usermod -s /bin/bash "$ruser"
    echo "Updated user $ruser (shell forced to /bin/bash)"
  fi

  for u in $users; do
    if id "$u" >/dev/null 2>&1; then
      usermod -aG "$group" "$u"
      echo "Added $u to group $group"
    else
      echo "Warning: user $u does not exist"
    fi
  done

  if [[ -d "$media_root" ]]; then
    chgrp -R "$group" "$media_root"
    chmod -R g+rwX "$media_root"
    find "$media_root" -type d -exec chmod g+s {} \;
    echo "Set group permissions on $media_root"
  else
    echo "Warning: $media_root does not exist yet"
  fi

  # Prepare authorized_keys
  home=$(getent passwd "$ruser" | cut -d: -f6)
  mkdir -p "$home/.ssh"
  touch "$home/.ssh/authorized_keys"
  chown -R "$ruser:$ruser" "$home/.ssh"
  chmod 700 "$home/.ssh"
  chmod 600 "$home/.ssh/authorized_keys"
  echo "Prepared $home/.ssh/authorized_keys"
  echo "Server setup done."
  echo "Next: set a temporary password so the client can install its key:"
  echo "  sudo passwd $ruser"
  echo "After the client key is installed you can lock the password:"
  echo "  sudo passwd -l $ruser"
}

cmd_new() {
  require_config
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: resolve-sync new <ProjectName>" >&2
    exit 1
  fi
  local dest="${SOURCE_ROOT}/${name}"
  if [[ -e "$dest" ]]; then
    echo "Project already exists: $dest" >&2
    exit 1
  fi
  mkdir -p "$SOURCE_ROOT"
  cp -a "$BANK_DIR" "$dest"
  echo "Created project: $dest"
}

# Shared rsync filter for Bins: only Proxy/*.mov
BINS_FILTER=(
  --include='Bins/'
  --include='Bins/**/'
  --include='Bins/**/Proxy/'
  --include='Bins/**/Proxy/*.mov'
  --exclude='Bins/**'
)

cmd_push() {
  require_config
  local project="${1:-}"
  local host
  host=$(get_working_host)
  if [[ -z "$project" ]]; then
    echo "Local projects in $SOURCE_ROOT:"
    local d
    for d in "$SOURCE_ROOT"/*/; do
      [[ -d "$d" ]] || continue
      is_valid_project "$d" && basename "$d"
    done
    return
  fi
  local src="${SOURCE_ROOT}/${project}"
  local dst="${host}:${REMOTE_ROOT}/${project}"
  echo "Pushing $project → $dst"
  # Bins proxies only
  rsync -av --delete "${BINS_FILTER[@]}" "$src/" "$dst/"
  # Assists both ways (simple last-write-wins)
  rsync -av --delete --include='Assists/***' --exclude='*' "$src/" "$dst/"
  rsync -av --delete --include='Assists/***' --exclude='*' "$dst/" "$src/"
  # Timeline with backup (simplified)
  echo "TODO: Timeline dated backup before overwrite"
  rsync -av --delete --include='Timeline/***' --exclude='*' "$src/" "$dst/"
  echo "Push done."
}

cmd_pull() {
  require_config
  local project=""
  local originals=0
  # Parse args: pull [Project] [--originals]
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --originals) originals=1 ;;
      *) project="$1" ;;
    esac
    shift
  done

  local host
  host=$(get_working_host)
  if [[ -z "$project" ]]; then
    echo "Projects on server ($host:$REMOTE_ROOT):"
    # List only first-level dirs that look like valid projects
    ssh "${SSH_OPTS_ARRAY[@]}" "$host" "
      for d in '$REMOTE_ROOT'/*/; do
        [ -d \"\$d/Bins\" ] && [ -d \"\$d/Assists\" ] && basename \"\$d\"
      done
    " 2>/dev/null || echo "(could not list)"
    return
  fi
  local src="${host}:${REMOTE_ROOT}/${project}"
  local dst="${SOURCE_ROOT}/${project}"
  echo "Pulling $project ← $src"
  mkdir -p "$dst"
  if [[ $originals -eq 1 ]]; then
    echo "(including full Bins / originals)"
    rsync -av --delete --include='Bins/***' --exclude='*' "$src/" "$dst/"
  else
    rsync -av --delete "${BINS_FILTER[@]}" "$src/" "$dst/"
  fi
  rsync -av --delete --include='Assists/***' --exclude='*' "$src/" "$dst/"
  echo "Pull done."
}

cmd_delete() {
  require_config
  local project="${1:-}"
  if [[ -z "$project" ]]; then
    echo "Usage: resolve-sync delete <ProjectName>" >&2
    exit 1
  fi
  local path="${SOURCE_ROOT}/${project}"
  if ! is_valid_project "$path"; then
    echo "Not a valid project (missing Bins/ or Assists/): $path" >&2
    exit 1
  fi
  read -rp "Sync $project back to server before deleting? [Y/n] " yn
  if [[ ! "$yn" =~ ^[Nn] ]]; then
    cmd_push "$project"
  fi
  read -rp "Delete $path from client? [y/N] " confirm
  if [[ "$confirm" =~ ^[Yy] ]]; then
    rm -rf "$path"
    echo "Deleted $path"
  else
    echo "Cancelled."
  fi
}

case "${1:-}" in
  setup)        cmd_setup ;;
  setup-server) cmd_setup_server ;;
  new)          cmd_new "${2:-}" ;;
  push)         cmd_push "${2:-}" ;;
  pull)         shift; cmd_pull "$@" ;;
  delete)       cmd_delete "${2:-}" ;;
  test)         cmd_test ;;
  help|""|-h|--help) usage ;;
  *)
    echo "Unknown command: $1" >&2
    usage
    exit 1
    ;;
esac
