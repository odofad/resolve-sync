#!/usr/bin/env bash
# resolve-sync-fix-perms — fix group permissions under a media root
# Intended to be called by the watcher or manually.

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <path>" >&2
  exit 1
fi

TARGET="$1"
GROUP="${RESOLVE_SYNC_GROUP:-media}"

if [[ ! -d "$TARGET" ]]; then
  echo "Not a directory: $TARGET" >&2
  exit 1
fi

# Safety: refuse to operate on root or paths outside a reasonable media tree
case "$TARGET" in
  /|/etc|/usr|/var|/home|/boot|/root) 
    echo "Refusing to operate on $TARGET" >&2
    exit 1
    ;;
esac

chgrp -R "$GROUP" "$TARGET" 2>/dev/null || true
chmod -R g+rwX "$TARGET" 2>/dev/null || true
find "$TARGET" -type d -exec chmod g+s {} \; 2>/dev/null || true
